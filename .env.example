# Backend database configuration
DB_URL=jdbc:mysql://localhost:3306/manager?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=shop_app
DB_PASSWORD=replace-with-your-local-password

# Optional one-time administrator bootstrap. Remove these values after the
# first successful startup.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# File storage
FILE_STORAGE_PATH=./files/
APP_HOST=localhost
CORS_ALLOWED_ORIGIN=http://localhost:8080

# Frontend API endpoint (copy this value into vue/.env.local if needed)
VITE_API_BASE_URL=http://localhost:9090

